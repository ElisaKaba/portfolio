<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Laisse passer les fichiers et dossiers qui existent réellement
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirige toutes les routes React vers index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Désactive l'affichage du contenu des dossiers
Options -Indexes

# Page d'erreur personnalisée
ErrorDocument 404 /index.html